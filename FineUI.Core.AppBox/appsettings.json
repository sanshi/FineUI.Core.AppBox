{
  "FineUI": {
    "EnableRazorForms": true,
    "CspScripts": true,
    "CspScriptsAllowSelf": true,
    "CspScriptsAllowNonce": true,
    "CspScriptsAllowUnsafeInline": false,
    "CspScriptsAllowUnsafeEval": false,
    "AllowDangerousRawTag": false,
    "AllowDangerousScriptTag": false,
    "DebugMode": true,
    "Theme": "Pure_Black",
    "EnableAnimation": false,
    "MobileAdaption": false,
    "CustomScrollbar": true,
    "FormRedStarPosition": "BeforeText",
    "FormLabelAlign": "Right",
    "GridHeaderFilterIconVisible": true,
    "GridHeaderSortIconVisible": true,
    "GridPagingToolbarVisible": true,
    "GridPagerAlignRight": true,
    "GridShowSelectionMessage": true,
    "GridPagingType": "Arrow"
  },
  "ConnectionStrings": {
    "SQLServer": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=fineui_core_appbox;Integrated Security=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
