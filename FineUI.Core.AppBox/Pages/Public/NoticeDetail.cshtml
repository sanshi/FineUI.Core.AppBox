@page
@model FineUI.Core.AppBox.Pages.Public.NoticeDetailModel
@{
    ViewData["Title"] = "NoticeDetail";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" IsViewPort="true" BodyPadding="10" Layout="Fit">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnClose" Icon="SystemClose" Text="关闭" ClickHandler="onCloseActiveWindowClick">
                    </f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Form ID="SimpleForm1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" BodyPadding="10" AutoScroll="true" LabelWidth="80">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:Label ID="labTitle" Label="标题">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label ID="labDepartment" Label="发布部门">
                            </f:Label>
                            <f:Label ID="labPublishTime" Label="发布时间">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label ID="labContent" Label="正文">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
        </Items>
    </f:Panel>

}


@section script {

}
