@{
    var F = Html.F();
}

@using FineUI.Core


<!DOCTYPE html>
<html>
<head>
    <title>FineUI.Core.AppBox - 通用权限管理系统</title>

    @F.RenderCss()
    
    <link rel="stylesheet" type="text/css" href="~/res/css/common.css?v@(GlobalConfig.ProductVersion)" />

    @RenderSection("head", false)

</head>
<body class="f-body-darkerbg">
    @Html.AntiForgeryToken()

    @F.PageManager

    @RenderSection("body", true)

    @F.RenderScript()

    <script type="text/javascript" src="~/res/js/common.js?v@(GlobalConfig.ProductVersion)"></script>
    @* AppBox 专属脚本，与 common.js 同层：这些回调在 iframe 子页里也会被调用 *@
    <script type="text/javascript" src="~/res/js/appbox-common.js?v@(GlobalConfig.ProductVersion)"></script>

    @RenderSection("script", false)

</body>
</html>
