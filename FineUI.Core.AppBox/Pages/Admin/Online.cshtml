@page
@model FineUI.Core.AppBox.Pages.Admin.OnlineModel
@{
    ViewData["Title"] = "Online";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="10" Title="职称管理" IsViewPort="true" Margin="20">
        <Items>
            <f:Form ShowBorder="true" ShowBorderShadow="true" BodyPadding="10" RemoveLastFieldsMargin="true" ShowHeader="false">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:TwinTriggerBox ID="ttbSearchMessage" ShowLabel="false" EmptyText="在用户名中搜索" Trigger1Icon="Clear" Trigger2Icon="Search"
                                              ShowTrigger1="false" ShowTrigger1="false" OnTrigger1Click="ttbSearchMessage_Trigger1Click" OnTrigger2Click="ttbSearchMessage_Trigger2Click">
                            </f:TwinTriggerBox>
                            <f:Label></f:Label>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" EnableCheckBoxSelect="false"
                    DataIDField="UserID" DataTextField="Name"
                    AllowSorting="true" SortField="UpdateTime" SortDirection="DESC" OnSort="Grid1_Sort"
                    AllowPaging="true" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged">
                <Columns>
                    <f:RowNumberField EnablePagingNumber="true"></f:RowNumberField>
                    <f:RenderField For="Onlines.First().UpdateTime" QuickSortField="true" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm" Width="150"></f:RenderField>
                    <f:RenderField For="Onlines.First().LoginTime" QuickSortField="true" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm" Width="150"></f:RenderField>
                    <f:RenderField For="Onlines.First().UserName" QuickSortField="true" Width="100"></f:RenderField>
                    <f:RenderField For="Onlines.First().UserChineseName" QuickSortField="true" Width="100"></f:RenderField>
                    <f:RenderField For="Onlines.First().IPAdddress" ExpandUnusedSpace="true"></f:RenderField>
                    <f:RenderField EnableColumnHide="false" EnableHeaderMenu="false" Width="100">
                        <Commands>
                            <f:Command CommandName="Edit" Icon="Pencil" ToolTip="查看"
                                       WindowID="Window1" WindowTitle="查看用户信息"
                                       WindowIFrameUrlFormatString="@Url.Content("~/Admin/UserView?id={0}")" _WindowIFrameUrlFields="ID" />
                        </Commands>
                    </f:RenderField>
                </Columns>
                <PageItems>
                    <f:ToolbarText Text="每页记录数："></f:ToolbarText>
                    <f:DropDownList ID="ddlGridPageSize" Width="80" OnSelectedIndexChanged="ddlGridPageSize_SelectedIndexChanged">
                        <Items>
                            <f:ListItem Text="10" Value="10"></f:ListItem>
                            <f:ListItem Text="20" Value="20"></f:ListItem>
                            <f:ListItem Text="50" Value="50"></f:ListItem>
                            <f:ListItem Text="100" Value="100"></f:ListItem>
                        </Items>
                    </f:DropDownList>
                </PageItems>
            </f:Grid>
        </Items>
    </f:Panel>

    <f:Window ID="Window1" IsModal="true" Hidden="true" Target="Top" EnableResize="true"
              EnableMaximize="true" EnableIFrame="true" Width="900" Height="650" OnClose="Window1_Close">
    </f:Window>

}

@section script {


}

