@page
@model FineUI.Core.AppBox.Pages.Admin.UserChangePasswordModel
@{
    ViewData["Title"] = "UserChangePassword";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" IsViewPort="true" BodyPadding="10" Layout="Fit">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnClose" Icon="SystemClose" Text="关闭" ClickHandler="onCloseActiveWindowClick">
                    </f:Button>
                    <f:ToolbarSeparator></f:ToolbarSeparator>
                    <f:Button ID="btnSaveClose" _ValidateForms="SimpleForm1" Icon="SystemSaveClose" OnClick="btnSaveClose_Click" OnClickFields="SimpleForm1" Text="保存后关闭"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" BodyPadding="10" AutoScroll="true">
                <Items>
                    <f:HiddenField For="CurrentUser.ID" ID="hfUserID"></f:HiddenField>
                    <f:Label For="CurrentUser.Name">
                    </f:Label>
                    <f:Label For="CurrentUser.ChineseName">
                    </f:Label>
                    <f:TextBox ID="tbxPassword" Label="新密码" TextMode="Password" Required="true" ShowRedStar="true">
                    </f:TextBox>
                    <f:TextBox ID="tbxConfirmPassword" Label="确认密码" TextMode="Password" Required="true" ShowRedStar="true" CompareControl="tbxPassword" CompareOperator="Equal"></f:TextBox>
                </Items> 
            </f:SimpleForm>
        </Items>
    </f:Panel>

}


