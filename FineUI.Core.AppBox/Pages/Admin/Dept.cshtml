@page
@model FineUI.Core.AppBox.Pages.Admin.DeptModel
@{
    ViewData["Title"] = "Dept";
}

@section body {
    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" IsViewPort="true" Margin="20">
        <Items>
            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" EnableCheckBoxSelect="false"
                    DataIDField="ID" DataTextField="Name"
                    EnableTree="true" TreeColumn="Name" DataParentIDField="ParentID" ExpandAllTreeNodes="true"
                    OnRowCommand="Grid1_RowCommand">
                <Columns>
                    <f:RowNumberField EnableTreeNumber="true"></f:RowNumberField>
                    <f:RenderField For="Depts.First().Name" QuickSortField="true" Width="180"></f:RenderField>
                    <f:RenderField For="Depts.First().Remark" QuickSortField="true" ExpandUnusedSpace="true"></f:RenderField>
                    <f:RenderField For="Depts.First().SortIndex" Width="80"></f:RenderField>
                    <f:RenderField EnableColumnHide="false" EnableHeaderMenu="false" Width="100">
                        <Commands>
                            <f:Command CommandName="Edit" Icon="Pencil" ToolTip="编辑"
                                       WindowID="Window1" WindowTitle="编辑"
                                       WindowIFrameUrlFormatString="@Url.Content("~/Admin/DeptEdit?id={0}")" _WindowIFrameUrlFields="ID" />
                            <f:Command CommandName="Delete" Icon="Delete" ToolTip="删除" CssClass="mybtn3" ConfirmText="确定删除此记录？" ConfirmTarget="Top" />
                        </Commands>
                    </f:RenderField>
                </Columns>
                <Toolbars>
                    <f:Toolbar ID="Toolbar1" Position="Top">
                        <Items>
                            <f:ToolbarFill></f:ToolbarFill>
                            <f:Button ID="btnNew" Icon="Add" Text="新增部门" ClickHandler="onNewClick">
                            </f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
            </f:Grid>
        </Items>
    </f:Panel>

    <f:Window ID="Window1" IsModal="true" Hidden="true" Target="Top" EnableResize="true" EnableMaximize="true"
              EnableIFrame="true" Width="900" Height="650" OnClose="Window1_Close"></f:Window>

}


@section script {
    <script>
        function onNewClick(event) {
            F.ui.Window1.show('@Url.Content("~/Admin/DeptNew")', '新增部门');
        }
    </script>
}

