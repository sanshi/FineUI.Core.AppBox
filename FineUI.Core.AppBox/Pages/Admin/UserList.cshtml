@page
@model FineUI.Core.AppBox.Pages.Admin.UserListModel
@{
    ViewData["Title"] = "UserList";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" Layout="VBox" BoxConfigSpace="10" ShowHeader="false" IsViewPort="true" Margin="20">
        <Items>
            <f:Form ShowBorder="true" ShowBorderShadow="true" BodyPadding="10" RemoveLastFieldsMargin="true" ShowHeader="false">
                <Rows>
                    <f:FormRow ID="FormRow1">
                        <Items>
                            <f:TwinTriggerBox ID="ttbSearchMessage" ShowLabel="false" EmptyText="在用户名称中搜索" Trigger1Icon="Clear" Trigger2Icon="Search"
                                              ShowTrigger1="false" OnTrigger1Click="ttbSearchMessage_Trigger1Click" OnTrigger2Click="ttbSearchMessage_Trigger2Click">
                            </f:TwinTriggerBox>
                            <f:RadioButtonList ID="rblEnableStatus" OnSelectedIndexChanged="rblEnableStatus_SelectedIndexChanged" Label="启用状态" ColumnNumber="3">
                                <Items>
                                    <f:RadioItem Text="全部" Selected="true" Value="all"></f:RadioItem>
                                    <f:RadioItem Text="启用" Value="enabled"></f:RadioItem>
                                    <f:RadioItem Text="禁用" Value="disabled"></f:RadioItem>
                                </Items>
                            </f:RadioButtonList>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" EnableCheckBoxSelect="true"
                    DataIDField="ID" DataTextField="Name"
                    AllowSorting="true" SortField="Name" SortDirection="DESC" OnSort="Grid1_Sort"
                    AllowPaging="true" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged"
                    OnRowCommand="Grid1_RowCommand">
                <Columns>
                    <f:RowNumberField EnablePagingNumber="true"></f:RowNumberField>
                    <f:RenderField For="Users.First().Name" QuickSortField="true" Width="100"></f:RenderField>
                    <f:RenderField For="Users.First().ChineseName" QuickSortField="true" Width="100" />
                    <f:RenderCheckField For="Users.First().Enabled" QuickSortField="true" RenderAsStaticField="true" Width="80" />
                    <f:RenderField For="Users.First().Gender" QuickSortField="true" Width="80" />
                    <f:RenderField For="Users.First().Email" QuickSortField="true" Width="180" />
                    <f:RenderField For="Users.First().Remark" ExpandUnusedSpace="true" />
                    <f:RenderField EnableColumnHide="false" EnableHeaderMenu="false" Width="150">
                        <Commands>
                            <f:Command CommandName="View" Icon="Information" ToolTip="查看用户信息"
                                       WindowID="Window1" WindowTitle="查看用户信息"
                                       WindowIFrameUrlFormatString="@Url.Content("~/Admin/UserView?id={0}")" _WindowIFrameUrlFields="ID" />
                            <f:Command CommandName="ChangePassword" Icon="Key" ToolTip="修改密码"
                                       WindowID="Window1" WindowTitle="修改密码"
                                       WindowIFrameUrlFormatString="@Url.Content("~/Admin/UserChangePassword?id={0}")" _WindowIFrameUrlFields="ID" />
                            <f:Command CommandName="Edit" Icon="Pencil" ToolTip="编辑"
                                       WindowID="Window1" WindowTitle="编辑"
                                       WindowIFrameUrlFormatString="@Url.Content("~/Admin/UserEdit?id={0}")" _WindowIFrameUrlFields="ID" />
                            <f:Command CommandName="Delete" Icon="Delete" ToolTip="删除" CssClass="mybtn3" ConfirmText="确定删除此记录？" ConfirmTarget="Top" />
                        </Commands>
                    </f:RenderField>
                </Columns>
                <PageItems>
                    <f:ToolbarText Text="每页记录数："></f:ToolbarText>
                    <f:DropDownList ID="ddlGridPageSize" Width="80" OnSelectedIndexChanged="ddlGridPageSize_SelectedIndexChanged">
                        <Items>
                            <f:ListItem Text="10" Value="10"></f:ListItem>
                            <f:ListItem Text="20" Value="20"></f:ListItem>
                            <f:ListItem Text="50" Value="50"></f:ListItem>
                            <f:ListItem Text="100" Value="100"></f:ListItem>
                        </Items>
                    </f:DropDownList>
                </PageItems>
                <Toolbars>
                    <f:Toolbar ID="Toolbar1" Position="Top">
                        <Items>
                            <f:Button ID="btnDeletedSelected" Icon="Delete" Text="删除选中记录" ClickHandler="onDeleteSelectedClick">
                            </f:Button>
                            <f:ToolbarSeparator></f:ToolbarSeparator>
                            <f:Button ID="btnChangeEnableUsers" Icon="GroupEdit" Text="设置启用状态">
                                <Menu>
                                    <f:MenuButton ID="btnEnableUsers" Text="启用选中记录" ClickHandler="onEnableUsersClick">
                                    </f:MenuButton>
                                    <f:MenuButton ID="btnDisableUsers" Text="禁用选中记录" ClickHandler="onDisableUsersClick">
                                    </f:MenuButton>
                                </Menu>
                            </f:Button>
                            <f:ToolbarFill></f:ToolbarFill>
                            <f:Button ID="btnNew" Icon="Add" Text="新增用户" ClickHandler="onNewClick"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
            </f:Grid>
        </Items>
    </f:Panel>

    <f:Window ID="Window1" IsModal="true" Hidden="true" Target="Top" EnableResize="true"
              EnableMaximize="true" EnableIFrame="true" Width="900" Height="650" OnClose="Window1_Close">
    </f:Window>
}


@section script {

    <script>


        function onNewClick(event) {
            F.ui.Window1.show('@Url.Content("~/Admin/UserNew")', '新增用户');
        }


        function onDeleteSelectedClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>{0}</b>&nbsp;行数据吗？', selectedRows.length),
                target: '_top',
                ok: function () {
                    // 触发后台事件
                    F.customEvent('Grid1_DeleteRows', {
                        rowIDs: selectedRows
                    });
                }
            });
        }

        function onEnableUsersClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要启用选中的&nbsp;<b>{0}</b>&nbsp;行数据吗？', selectedRows.length),
                target: '_top',
                ok: function () {
                    // 触发后台事件
                    F.customEvent('Grid1_EnableRows', {
                        action: 'enable',
                        rowIDs: selectedRows
                    });
                }
            });
        }

        function onDisableUsersClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要禁用选中的&nbsp;<b>{0}</b>&nbsp;行数据吗？', selectedRows.length),
                target: '_top',
                ok: function () {
                    // 触发后台事件
                    F.customEvent('Grid1_EnableRows', {
                        action: 'disable',
                        rowIDs: selectedRows
                    });
                }
            });
        }


    </script>
}
