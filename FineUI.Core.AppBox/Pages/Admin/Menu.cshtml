@page
@model FineUI.Core.AppBox.Pages.Admin.MenuModel
@{
    ViewData["Title"] = "Menu";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" Layout="Fit" ShowHeader="false" IsViewPort="true" Margin="20">
        <Items>
            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" EnableCheckBoxSelect="false"
                    DataIDField="ID" DataTextField="Name"
                    EnableTree="true" TreeColumn="Name" DataParentIDField="ParentID" ExpandAllTreeNodes="true"
                    OnRowCommand="Grid1_RowCommand">
                <Columns>
                    <f:RowNumberField EnableTreeNumber="true"></f:RowNumberField>
                    <f:RenderField For="Menus.First().Name" Width="200"></f:RenderField>
                    <f:RenderField For="Menus.First().NavigateUrl" Width="200"></f:RenderField>
                    <f:RenderField For="Menus.First().ViewPowerName" Width="150"></f:RenderField>
                    <f:RenderField For="Menus.First().ImageUrl" RendererFunction="renderImageUrl" Width="80"></f:RenderField>
                    <f:RenderField For="Menus.First().Remark" ExpandUnusedSpace="true"></f:RenderField>
                    <f:RenderField For="Menus.First().SortIndex" Width="80"></f:RenderField>
                    <f:RenderField EnableColumnHide="false" EnableHeaderMenu="false" Width="100">
                        <Commands>
                            <f:Command CommandName="Edit" Icon="Pencil" ToolTip="编辑"
                                       WindowID="Window1" WindowTitle="编辑"
                                       WindowIFrameUrlFormatString="@Url.Content("~/Admin/MenuEdit?id={0}")" _WindowIFrameUrlFields="ID" />
                            <f:Command CommandName="Delete" Icon="Delete" ToolTip="删除" CssClass="mybtn3" ConfirmText="确定删除此记录？" ConfirmTarget="Top" />
                        </Commands>
                    </f:RenderField>
                </Columns>
                <Toolbars>
                    <f:Toolbar ID="Toolbar1" Position="Top">
                        <Items>
                            <f:ToolbarFill></f:ToolbarFill>
                            <f:Button ID="btnNew" Icon="Add" Text="新增菜单" ClickHandler="onNewClick">
                            </f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
            </f:Grid>
        </Items>
    </f:Panel>


    <f:Window ID="Window1" IsModal="true" Hidden="true" Target="Top" EnableResize="true"
              EnableMaximize="true" EnableIFrame="true" Width="900" Height="650" OnClose="Window1_Close">
    </f:Window>

}


@section script {

    <script>

        function onNewClick(event) {
            F.ui.Window1.show('@Url.Content("~/Admin/MenuNew")', '新增菜单');
        }


        function renderImageUrl(value, params) {
            var imageUrl = value.replace(/^~\//, F.baseUrl);
            return '<img src="' + F.htmlEncode(imageUrl) + '" />';
        }

    </script>
}

