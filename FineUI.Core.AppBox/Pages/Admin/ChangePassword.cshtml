@page
@model FineUI.Core.AppBox.Pages.Admin.ChangePasswordModel
@{
    ViewData["Title"] = "ChangePassword";
}

@section body {

    <f:Panel ID="Panel1" BodyPadding="10" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" IsFluid="true" AutoScroll="true" Margin="20">
        <Items>
            <f:SimpleForm ID="SimpleForm1" LabelWidth="100" LabelAlign="Top" ShowBorder="false" ShowHeader="false" Width="600">
                <Items>
                    <f:TextBox ID="tbxOldPassword" TextMode="Password" Label="当前密码" Required="true" ShowRedStar="true"></f:TextBox>
                    <f:TextBox ID="tbxNewPassword" TextMode="Password" Label="新密码" Required="true" ShowRedStar="true"></f:TextBox>
                    <f:TextBox ID="tbxConfirmNewPassword" TextMode="Password" Label="确认新密码" Required="true" ShowRedStar="true"></f:TextBox>
                    <f:Button ID="btnSave" Icon="SystemSave" OnClick="btnSave_Click" _ValidateForms="SimpleForm1" ValidateTarget="Top" Text="修改密码"></f:Button>
                </Items>
            </f:SimpleForm>
        </Items>
    </f:Panel>

}



