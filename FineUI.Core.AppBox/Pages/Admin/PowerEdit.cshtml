@page
@model FineUI.Core.AppBox.Pages.Admin.PowerEditModel
@{
    ViewData["Title"] = "PowerEdit";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" IsViewPort="true" BodyPadding="10" Layout="Fit">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnClose" Icon="SystemClose" Text="关闭" ClickHandler="onCloseActiveWindowClick">
                    </f:Button>
                    <f:ToolbarSeparator></f:ToolbarSeparator>
                    <f:Button ID="btnSaveClose" _ValidateForms="SimpleForm1" Icon="SystemSaveClose" OnClick="btnSaveClose_Click" OnClickFields="SimpleForm1" Text="保存后关闭"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" BodyPadding="10" AutoScroll="true">
                <Items>
                    <f:HiddenField For="Power.ID"></f:HiddenField>
                    <f:TextBox For="Power.GroupName">
                    </f:TextBox>
                    <f:TextBox For="Power.Name">
                    </f:TextBox>
                    <f:TextBox For="Power.Title">
                    </f:TextBox>
                    <f:TextArea For="Power.Remark"></f:TextArea>
                </Items>
            </f:SimpleForm>
        </Items>
    </f:Panel>

}



