@page
@model FineUI.Core.AppBox.Pages.Admin.UserViewModel
@{
    ViewData["Title"] = "UserView";
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" IsViewPort="true" BodyPadding="10" Layout="Fit">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnClose" Icon="SystemClose" Text="关闭" ClickHandler="onCloseActiveWindowClick">
                    </f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Form ID="SimpleForm1" ShowBorder="true" ShowBorderShadow="true" ShowHeader="false" BodyPadding="10" AutoScroll="true">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Name">
                            </f:Label>
                            <f:Label For="CurrentUser.ChineseName">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Gender">
                            </f:Label>
                            <f:Label For="CurrentUser.Enabled" ID="labEnabled">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Email">
                            </f:Label>
                            <f:Label For="CurrentUser.CompanyEmail">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.OfficePhone">
                            </f:Label>
                            <f:Label For="CurrentUser.OfficePhoneExt">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.HomePhone">
                            </f:Label>
                            <f:Label For="CurrentUser.CellPhone">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Roles" ID="labRoles">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Titles" ID="labTitles">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Dept" ID="labDept">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:Label For="CurrentUser.Remark">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
        </Items>
    </f:Panel>

}


