@page
@model FineUI.Core.AppBox.Pages.Admin.ConfigModel
@{
    ViewData["Title"] = "Config";
}

@section body {
    <f:Panel ID="Panel1" ShowHeader="false" ShowBorder="true" ShowBorderShadow="true" BodyPadding="10" IsFluid="true" AutoScroll="true" Margin="20">
        <Items>
            <f:SimpleForm ID="SimpleForm1" LabelAlign="Top" ShowBorder="false" ShowHeader="false" Width="600">
                <Items>
                    <f:DropDownList ID="ddlPageSize" Label="表格默认记录数" Required="true" ShowRedStar="true" SelectedValue="@ConfigHelper.PageSize.ToString()">
                        <Items>
                            <f:ListItem Text="10" Value="10"></f:ListItem>
                            <f:ListItem Text="20" Value="20"></f:ListItem>
                            <f:ListItem Text="50" Value="50"></f:ListItem>
                            <f:ListItem Text="100" Value="100"></f:ListItem>
                        </Items>
                    </f:DropDownList>
                    <f:TextArea ID="tbxHelpList" Height="450" Label="帮助下拉列表" Required="true" ShowRedStar="true"></f:TextArea>
                    <f:Button ID="btnSave" Icon="SystemSave" OnClick="btnSave_Click" _ValidateForms="SimpleForm1" ValidateTarget="Top" Text="保存"></f:Button>
                </Items>
            </f:SimpleForm>
        </Items>
    </f:Panel>

}



